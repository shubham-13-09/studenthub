# Copy this file to ".env" (same folder) and fill in YOUR values.
# NEVER commit ".env" and never share it (zip / chat / screenshots).

# ---- Database (use a dedicated MySQL user, NOT root - see create_db_user.sql) ----
DB_HOST=localhost
DB_USER=studenthub_app
DB_PASSWORD=change-me
DB_NAME=studenthub

# ---- Login tokens ----
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=paste-a-64-character-random-string-here

# ---- OTP e-mails (Gmail App Password, not your normal Gmail password) ----
GMAIL_USER=your-college-mail@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ---- Server ----
# Keep False everywhere except on your own laptop while developing.
FLASK_DEBUG=False
PORT=5000
# Comma separated list of frontend URLs allowed to call the API (CORS)
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
# MAX_CONTENT_LENGTH=26214400

# ---- Optional AI assistant keys (only if you use them) ----
# GEMINI_API_KEY=
# GEMINI_MODEL=
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
